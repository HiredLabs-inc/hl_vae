# Local overrides for hl_vae.settings.dev (DES-003).
#
# Nothing here is needed: with no .env, dev runs on SQLite with DEBUG on.
# To override, copy this file to .env (gitignored) and uncomment what you need.
# Shell variables (and `docker run -e`) win over .env.
# Only dev.py reads .env; tests and the Docker build ignore it.
# Never put real stage or prod secrets here.

# Turn DEBUG off locally. Then run `uv run python manage.py collectstatic --noinput` first (DES-006).
# DJANGO_DEBUG=false

# Use your own dev key instead of the built-in dev-only one.
# DJANGO_SECRET_KEY=

# Comma-separated hosts. Default: localhost,127.0.0.1,[::1]
# ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL. Default: SQLite at db.sqlite3 in the repo root.
# DATABASE_URL=postgres://vae:vae@localhost:5432/vae

# Hosted (Cloud Run) variables live in the vae-stage-app-env Secret Manager
# secret, not here. Their catalogue is in infra/README.md (DES-008).
